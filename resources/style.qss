/* Nocturne theme for TalkTrack */

QMainWindow, QDialog, QWidget {
    background-color: #161826;
    color: #e9e9ed;
    font-family: "Inter Variable", "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* Base widgets should be transparent to let backgrounds show through */
QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

/* Menu Bar */
QMenuBar {
    background-color: #12141f;
    color: #9397ab;
    border-bottom: 1px solid #292b31;
    padding: 3px 6px;
    font-size: 13px;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: rgba(145,132,217,0.14);
    color: #9184d9;
}

QMenu {
    background-color: #232532;
    border: 1px solid #3f424d;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 5px 9px;
    border-radius: 4px;
    font-size: 12.5px;
}

QMenu::item:selected {
    background-color: rgba(145,132,217,0.12);
    color: #9184d9;
}

QMenu::separator {
    height: 1px;
    background-color: #3f424d;
    margin: 5px 6px;
}

/* Buttons (Rest) */
QPushButton {
    background-color: transparent;
    color: #e9e9ed;
    border: 1px solid rgba(233,233,237,0.16);
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 500;
    font-size: 12.5px;
}

/* Buttons (Hover) */
QPushButton:hover {
    background-color: rgba(233,233,237,0.07);
}

/* Buttons (Pressed) */
QPushButton:pressed {
    background-color: rgba(233,233,237,0.14);
}

/* Buttons (Focus) */
QPushButton:focus {
    border: 2px solid #9184d9;
    outline: none;
}

/* Buttons (Disabled) */
QPushButton:disabled {
    color: rgba(233,233,237,0.45);
    border-color: rgba(233,233,237,0.07);
}

/* Primary actions (Accent outline) */
QPushButton#primaryAction {
    border-color: #9184d9;
    color: #9184d9;
}
QPushButton#primaryAction:hover {
    background-color: rgba(145,132,217,0.12);
}
QPushButton#primaryAction:pressed {
    background-color: rgba(145,132,217,0.22);
}

/* Record action (rec outline) — Record/Stop always take the signal-red
   outline, never the accent, per the design spec's state table. */
QPushButton#recordAction {
    border-color: #f38ba8;
    color: #f38ba8;
}
QPushButton#recordAction:hover {
    background-color: rgba(243,139,168,0.12);
}
QPushButton#recordAction:pressed {
    background-color: rgba(243,139,168,0.22);
}

/* Search mode toggle (Aa/AI) — fixed 30px width, needs tighter padding
   than the generic QPushButton rule or the text gets clipped to nothing */
QPushButton#searchModeToggle {
    padding: 4px 2px;
    font-size: 11px;
}

/* Recordings list filter chips (All / Untranscribed / Tagged) */
QPushButton#filterChip, QPushButton#filterChipAccent {
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#filterChip:checked {
    background-color: rgba(233,233,237,0.14);
    border-color: rgba(233,233,237,0.30);
}
QPushButton#filterChipAccent:checked {
    background-color: rgba(145,132,217,0.18);
    border-color: #9184d9;
    color: #9184d9;
}

/* Combo boxes */
QComboBox {
    background-color: transparent;
    color: #e9e9ed;
    border: 1px solid rgba(233,233,237,0.16);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12.5px;
}
QComboBox:hover {
    background-color: rgba(233,233,237,0.07);
}
QComboBox:on {
    background-color: rgba(233,233,237,0.14);
}
QComboBox:focus {
    border: 2px solid #9184d9;
}
QComboBox:disabled {
    color: rgba(233,233,237,0.45);
    border-color: rgba(233,233,237,0.07);
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #232532;
    color: #e9e9ed;
    border: 1px solid #3f424d;
    selection-background-color: rgba(145,132,217,0.12);
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
}

/* Labels */
QLabel {
    color: #e9e9ed;
    font-size: 14px;
}
QLabel#timerLabel {
    font-size: 25px;
    font-weight: 600;
    font-family: "Consolas", monospace;
    color: #e9e9ed;
}
QLabel#recordingIndicator {
    color: #f38ba8;
    font-weight: 600;
}
QLabel#sectionHeader {
    font-size: 11px;
    font-weight: 600;
    color: #9397ab;
    letter-spacing: 0.10em;
    text-transform: uppercase;
}

/* Recordings list row: bold name, muted/smaller date + duration */
QLabel#recordingRowName {
    font-size: 13.5px;
    font-weight: 600;
    color: #f2f2f5;
}
QLabel#recordingRowDate,
QLabel#recordingRowDur {
    font-size: 11.5px;
    color: #75798c;
}

/* Text areas */
QTextEdit, QPlainTextEdit, QLineEdit {
    background-color: transparent;
    color: #e9e9ed;
    border: 1px solid rgba(233,233,237,0.16);
    border-radius: 8px;
    padding: 8px;
    selection-background-color: rgba(145,132,217,0.22);
}
QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus {
    border: 2px solid #9184d9;
}

/* List widgets */
QListWidget {
    background-color: transparent;
    color: #e9e9ed;
    border: none;
    border-top: 1px solid #292b31;
}
QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #1c1e29;
    border-left: 2px solid transparent;
}
QListWidget::item:selected {
    background-color: rgba(145,132,217,0.10);
    border-left: 2px solid #9184d9;
}
QListWidget::item:hover:!selected {
    background-color: rgba(233,233,237,0.07);
}
QListWidget:focus QListWidget::item:focus {
    border: 2px solid #9184d9;
}

/* Check Box */
QCheckBox {
    color: #e9e9ed;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid rgba(233,233,237,0.25);
    background-color: #1e1e2e;
}
QCheckBox::indicator:hover {
    background-color: rgba(233,233,237,0.12);
    border-color: #9184d9;
}
QCheckBox::indicator:checked {
    background-color: #9184d9;
    border-color: #9184d9;
}
QCheckBox:focus {
    border: none;
}
QCheckBox::indicator:focus {
    border: 2px solid #9184d9;
}

/* Radio Button */
QRadioButton {
    color: #e9e9ed;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid rgba(233,233,237,0.30);
    background-color: #1e1e2e;
}
QRadioButton::indicator:hover {
    background-color: rgba(145,132,217,0.15);
    border-color: #9184d9;
}
QRadioButton::indicator:checked {
    background-color: #9184d9;
    border-color: #9184d9;
}
QRadioButton:focus {
    border: none;
}
QRadioButton::indicator:focus {
    border: 2px solid #9184d9;
}

/* Scroll bars */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #3f424d;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #595d6c;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* Progress bar */
QProgressBar {
    background-color: #292b31;
    border: none;
    border-radius: 2px;
    text-align: center;
    color: #e9e9ed;
    min-height: 4px;
    max-height: 4px;
}
QProgressBar::chunk {
    background-color: #9184d9;
    border-radius: 2px;
}

/* Status bar */
QStatusBar {
    background-color: #12141f;
    color: #75798c;
    border-top: 1px solid #292b31;
}

/* Splitter */
QSplitter::handle {
    background-color: #292b31;
    width: 1px;
    height: 1px;
}

/* Tooltips */
QToolTip {
    background-color: #232532;
    color: #e9e9ed;
    border: 1px solid #3f424d;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Specific elements needing migration from old classes */
QFrame#collapsibleHeader {
    background-color: transparent;
    border-bottom: 1px solid #292b31;
}
QToolButton#collapsibleToggle {
    border: none;
    background: transparent;
    color: #e9e9ed;
    font-weight: 600;
    font-family: 'Inter Variable', 'Inter', sans-serif;
    text-align: left;
    padding: 8px 0;
}
QToolButton#collapsibleToggle:hover {
    color: #cfd3e5;
}

/* Remove old Catppuccin red/green button fills. Replaced by transparent with colored borders where appropriate */
QPushButton#recordButton {
    border: 1px solid #f38ba8;
    color: #f38ba8;
}
QPushButton#recordButton:hover {
    background-color: rgba(243,139,168,0.12);
}
QPushButton#recordButton:pressed {
    background-color: rgba(243,139,168,0.22);
}

QPushButton#stopButton {
    border: 1px solid #f38ba8;
    color: #f38ba8;
}
QPushButton#stopButton:hover {
    background-color: rgba(243,139,168,0.12);
}

QPushButton#pauseButton {
    border: 1px solid #f9e2af;
    color: #f9e2af;
}
QPushButton#pauseButton:hover {
    background-color: rgba(249,226,175,0.12);
}

/* Sources dialog (Screen 3 of the UI redesign) */
QListWidget::item:disabled {
    color: #595d6c;
}
QLabel#sourcesHeaderTitle {
    font-size: 15px;
    font-weight: 600;
    color: #e9e9ed;
}
QLabel#sourcesHeaderSubtitle {
    font-size: 12px;
    color: #9397ab;
}
QLabel#sourcesLockNotice {
    background-color: rgba(249,226,175,0.10);
    color: #f9e2af;
    border: 1px solid rgba(249,226,175,0.35);
    border-radius: 8px;
    padding: 8px 11px;
    font-size: 12px;
}
QFrame#sourceModeCard {
    background-color: #1c1e29;
    border: 1px solid #292b31;
    border-radius: 8px;
}
QFrame#sourceModeCard:hover {
    border-color: #3f424d;
}
QLabel#modeCardDescription {
    color: #9397ab;
    font-size: 11px;
}
QLabel#modeCardRecommended {
    color: #a6e3a1;
    background-color: rgba(166,227,161,0.12);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 600;
}
QFrame#sourcesFooter {
    border-top: 1px solid #292b31;
    margin-top: 6px;
}
